<!DOCTYPE html>
<html lang="lt" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title><%= challenge.title %> - CryptoCTF</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>

<body class="bg-dark text-light d-flex flex-column min-vh-100">

    <header>
        <%- include('partials/navbar') %>
    </header>

    <main class="container flex-grow-1 py-5">

        <a href="/challenges" class="btn btn-outline-secondary mb-4">
            Grįžti į uždavinius
        </a>

        <div class="card">
            <div class="card-body p-4">

                <h1><%= challenge.title %></h1>

                <p class="text-secondary">
                    Kategorija: <%= challenge.category %>
                </p>

                <p>
                    Sudėtingumas:
                    <strong><%= challenge.difficulty %></strong>
                </p>

                <p class="fw-bold">
                    Taškai: <%= challenge.points %>
                </p>

                <hr>

                <h2 class="h4">Uždavinio aprašymas</h2>

                <p><%= challenge.description %></p>

                <hr>

                <h2 class="h4">Pateikti flag</h2>

                <form method="POST" action="/challenges/<%= challenge.id %>/submit">

                    <div class="mb-3">
                        <label for="flag" class="form-label">
                            Įveskite rastą flag
                        </label>

                        <input
                            type="text"
                            class="form-control"
                            id="flag"
                            name="flag"
                            placeholder="CTF{...}"
                            maxlength="200"
                            required
                        >
                    </div>

                    <button type="submit" class="btn btn-success">
                        Pateikti atsakymą
                    </button>

                </form>

            </div>
        </div>

    </main>

    <%- include('partials/footer') %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
