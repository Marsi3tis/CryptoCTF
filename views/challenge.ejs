<!DOCTYPE html>
<html lang="lt" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="CryptoCTF kriptografijos uždavinys">
    <title><%= challenge.title %> – CryptoCTF</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&family=Permanent+Marker&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/challenges.css">
    <link rel="stylesheet" href="/css/challenge-detail.css">
</head>
<body class="challenges-page challenge-detail-page d-flex flex-column min-vh-100">

    <header>
        <%- include('partials/navbar') %>
    </header>

    <main class="challenge-main container flex-grow-1">
        <a href="/challenges" class="challenge-back-link">&larr; Grįžti į uždavinius</a>

        <section class="challenge-hero" aria-labelledby="challenge-title">
            <div class="challenge-hero-copy">
                <p class="challenge-eyebrow">CRYPTOCTF // IŠŠŪKIS #<%= challenge.id %></p>
                <h1 id="challenge-title"><%= challenge.title %></h1>
                <p>Rask paslėptą atsakymą ir įveik šį šifrą.</p>
            </div>
            <div class="challenge-hero-art" aria-hidden="true"></div>
        </section>

        <section class="challenge-detail-panel" aria-label="Uždavinio informacija ir atsakymo pateikimas">
            <div class="challenge-detail-meta">
                <span>Kategorija: <strong><%= challenge.category %></strong></span>
                <span>Sudėtingumas: <strong><%= challenge.difficulty %></strong></span>
                <span class="challenge-detail-points"><%= challenge.points %> taškų</span>
            </div>

            <div class="challenge-detail-content">
                <h2>Uždavinio aprašymas</h2>
                <p class="challenge-detail-description"><%= challenge.description %></p>
            </div>

            <div class="challenge-detail-submit">
                <h2>Pateikti flag</h2>
                <p>Įvesk rastą atsakymą. Teisingus atsakymus vėliau tikrins serveris.</p>

                <form method="POST" action="/challenges/<%= challenge.id %>/submit">
                    <div class="mb-3">
                        <label for="flag" class="form-label">Rastas flag</label>
                        <input
                            class="form-control challenge-flag-input"
                            type="text"
                            id="flag"
                            name="flag"
                            placeholder="CTF{...}"
                            maxlength="200"
                            autocomplete="off"
                            spellcheck="false"
                            required
                        >
                    </div>
                    <button type="submit" class="btn challenge-detail-button">Pateikti atsakymą</button>
                </form>
            </div>
        </section>
    </main>

    <%- include('partials/footer') %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
