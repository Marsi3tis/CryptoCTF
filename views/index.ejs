
<!DOCTYPE html>
<html lang="lt" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CryptoCTF - Pradžia</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>

<body class="bg-dark text-light d-flex flex-column min-vh-100">

    <header>
        <%- include('partials/navbar')%>
    </header>

    <main class="container flex-grow-1 py-5">

        <section class="text-center py-5">
            <h1 class="display-4 fw-bold">
                Sveiki atvykę į CryptoCTF!
            </h1>

            <p class="lead text-secondary mt-3">
                Spręsk kriptografijos uždavinius,
                rask flag ir rink taškus!
            </p>
        </section>

        <section class="row g-4 mt-4">

            <div class="col-md-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h2 class="h5">CTF uždaviniai</h2>
                        <p class="card-text">
                            Spręsk įvairaus sudėtingumo
                            kriptografijos užduotis.
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h2 class="h5">Rink taškus</h2>
                        <p class="card-text">
                            Pateik teisingą flag ir
                            gauk taškų už sprendimą.
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h2 class="h5">Stebėk progresą</h2>
                        <p class="card-text">
                            Savo profilyje matyk taškus
                            ir išspręstus uždavinius.
                        </p>
                    </div>
                </div>
            </div>

        </section>

    </main>

    <%- include('partials/footer') %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
