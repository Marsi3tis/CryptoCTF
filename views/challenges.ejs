<!DOCTYPE html>
<html lang="lt" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="CryptoCTF – kriptografijos CTF uždaviniai.">
    <title>Uždaviniai – CryptoCTF</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&family=Permanent+Marker&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/challenges.css">
</head>
<body class="challenges-page d-flex flex-column min-vh-100">
    <header>
        <%- include('partials/navbar') %>
    </header>

    <main class="challenge-main container flex-grow-1">
        <section class="challenge-hero" aria-labelledby="challenges-title">
            <div class="challenge-hero-copy">
                <p class="challenge-eyebrow">CTF // KRIPTOGRAFIJA</p>
                <h1 id="challenges-title">Uždaviniai</h1>
                <p>Pasirink challenge, rask paslėptą atsakymą ir uždirbk taškų.</p>
            </div>
            <div class="challenge-hero-art" aria-hidden="true"></div>
        </section>

        <section class="challenge-list" aria-label="CTF uždavinių sąrašas">
            <div class="challenge-section-heading">
                <h2>Visi iššūkiai</h2>
                <p>Uždavinių: <%= challenges.length %></p>
            </div>

            <% if (challenges.length === 0) { %>
                <p class="challenge-empty">Uždavinių kol kas nėra.</p>
            <% } else { %>
                <div class="row g-4">
                    <% challenges.forEach(challenge => { %>
                        <div class="col-md-6 col-lg-4">
                            <article class="card challenge-card h-100">
                                <div class="card-body d-flex flex-column">
                                    <p class="challenge-card-kicker">CTF / <%= challenge.category %></p>
                                    <h3 class="challenge-card-title"><%= challenge.title %></h3>
                                    <p class="challenge-card-description"><%= challenge.description %></p>

                                    <div class="challenge-card-meta mt-auto">
                                        <span>Sudėtingumas: <strong><%= challenge.difficulty %></strong></span>
                                        <span class="challenge-points"><%= challenge.points %> taškų</span>
                                    </div>
                                    <a class="btn challenge-button" href="/challenges/<%= challenge.id %>">
                                        Spręsti uždavinį
                                    </a>
                                </div>
                            </article>
                        </div>
                    <% }) %>
                </div>
            <% } %>
        </section>
    </main>

    <%- include('partials/footer') %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
